{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "debian"
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "MitraOS V.1 (Apollo Edition) x86_64"
    },
    {
      "type": "host",
      "format": "{2}"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "break",
    "colors"
  ]
}
