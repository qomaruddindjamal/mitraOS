#!/bin/bash
{
	#//////////////////////////////////////////////////////////////////
	# MitraOS System Preferences - 23 Core Categories
	# Founder: Qomaruddin Djamal
	# Company: Citra Media Technology & Mitra Utama Group
	# Location: /opt/mitraos/bin/mitra-preferences
	#//////////////////////////////////////////////////////////////////

	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
	for g_lib in "$SCRIPT_DIR/../lib/mitra-globals" \
	             "/opt/mitraos/lib/mitra-globals" \
	             "/boot/apollo/func/mitra-globals" \
	             "/boot/apollo/mitra-globals" \
	             "/boot/mitraos/func/mitra-globals" \
	             "/usr/lib/mitraos/mitra-globals" \
	             "/usr/share/mitraos/mitra-globals"; do
		if [[ -f "$g_lib" ]]; then
			. "$g_lib"
			break
		fi
	done

	# Safe Fallbacks if running standalone
	if ! declare -F G_WHIP_MSG >/dev/null 2>&1; then
		G_WHIP_MSG() { whiptail --title "$1" --msgbox "$2" "${3:-16}" "${4:-74}" 2>/dev/null || echo -e "[$1]\n$2\n"; }
	fi
	if ! declare -F G_CHECK_ROOT_USER >/dev/null 2>&1; then
		G_CHECK_ROOT_USER() { :; }
	fi
	if ! declare -F G_EXIT_BANNER >/dev/null 2>&1; then
		G_EXIT_BANNER() { clear; }
	fi

	G_PROGRAM_NAME='MitraOS - System Preferences'
	G_CHECK_ROOT_USER "$@"

	# Helper message dialog
	show_info() {
		local title="$1"
		local text="$2"
		G_WHIP_MSG "$title" "$text" 16 74
	}

	# -------------------------------------------------------------
	# 1. Appearance
	# -------------------------------------------------------------
	menu_appearance() {
		while true; do
			local choice
			choice=$(whiptail --title "System Preferences: Appearance" --menu "Pilih pengaturan tampilan:" 18 74 8 \
				"1" "Theme (Mitra Dark / Slate / Light / Cupertino)" \
				"2" "Light / Dark Mode" \
				"3" "Accent Color (Electric Cyan, Amber, Sapphire, Emerald)" \
				"4" "Icons (MitraOS Modern / Papirus / Flat-Remix)" \
				"5" "Fonts (Inter, SF Pro, Roboto, JetBrains Mono)" \
				"6" "Wallpaper (Ganti Latar Belakang MitraOS)" \
				"7" "Window Style (macOS Traffic Light / Win11 Rounded)" \
				"8" "Animations (Enable / Disable Window Transitions)" \
				"B" "<-- Kembali ke Menu Utama" 3>&1 1>&2 2>&3)
			[[ -z "$choice" || "$choice" == "B" ]] && break

			case "$choice" in
				1) show_info "Theme" "Tema Aktif: MitraOS Dark Modern (Slate & Neon Cyan)\n\nPreset tersedia:\n- MitraOS Dark Modern (Default)\n- Cupertino Glass (macOS Style)\n- Windows 11 Fluent Dark\n- High-Contrast Terminal Minimal" ;;
				2) show_info "Light / Dark Mode" "Mode saat ini: DARK MODE (High Contrast)\n\nMode malam menghemat energi dan mengurangi kelelahan mata." ;;
				3) show_info "Accent Color" "Warna Aksen Aktif: Electric Cyan (#00d2ff) & Amber (#ff6f00)." ;;
				4) show_info "Icons" "Paket Ikon: MitraOS Vector Icons (Papirus based) aktif." ;;
				5) show_info "Fonts" "Font Antarmuka: Inter 10pt\nFont Terminal: JetBrains Mono 11pt\nFont Window Title: SF Pro Display 10pt." ;;
				6)
					if [[ -x "$SCRIPT_DIR/mitra-desktop" ]]; then
						"$SCRIPT_DIR/mitra-desktop" --wallpaper
					else
						show_info "Wallpaper" "Wallpaper Aktif: /usr/share/backgrounds/mitra-wallpaper.jpg"
					fi
					;;
				7) show_info "Window Style" "Gaya Jendela: macOS Traffic Light Buttons (Kiri Atas: Merah, Kuning, Hijau) dengan sudut membulat 12px." ;;
				8) show_info "Animations" "Animasi Jendela & Transisi: AKTIF (Compositor: Picom / Xfwm4)." ;;
			esac
		done
	}

	# -------------------------------------------------------------
	# 2. Display
	# -------------------------------------------------------------
	menu_display() {
		local curr_res="1920x1080"
		if command -v xrandr >/dev/null 2>&1; then
			curr_res=$(xrandr 2>/dev/null | grep '*' | awk '{print $1}' | head -n1)
		fi
		show_info "Display Settings" "Resolusi Layar Saat Ini: ${curr_res:-1920x1080}\nRefresh Rate: 60 Hz\nScale: 100% (HiDPI Auto-Detect)\nOrientation: Normal (Landscape)\nNight Light: Siap Dikonfigurasi (Redshift / sct)."
	}

	# -------------------------------------------------------------
	# 3. Mouse & Touchpad
	# -------------------------------------------------------------
	menu_mouse() {
		show_info "Mouse & Touchpad" "Kecepatan Pointer: Normal (Accel: 1.0)\nNatural Scrolling: Aktif (Gaya macOS/Modern)\nTouchpad Tap-to-Click: Aktif\nGesture Dukungan: 3-finger swipe (Workspaces), 2-finger pinch (Zoom)."
	}

	# -------------------------------------------------------------
	# 4. Keyboard
	# -------------------------------------------------------------
	menu_keyboard() {
		show_info "Keyboard" "Tata Letak Keyboard: US QWERTY (Bahasa Indonesia / English)\nRepeat Delay: 250ms | Repeat Rate: 30/s\nShortcuts Utama:\n- Super + Panah: Snap Layout Jendela\n- Super + Space: App Launcher\n- Super + T: Terminal MitraOS"
	}

	# -------------------------------------------------------------
	# 5. Network
	# -------------------------------------------------------------
	menu_network() {
		local ip_info
		ip_info=$(ip -4 addr show 2>/dev/null | grep -E 'inet ' | awk '{print $NF ": " $2}' | tr '\n' ' ')
		show_info "Network Information" "Status Jaringan MitraOS:\n\nKoneksi Aktif:\n${ip_info:-127.0.0.1 (Loopback)}\n\nDNS: 1.1.1.1, 8.8.8.8\nFirewall: UFW Aktif (Default DENY Incoming, ALLOW Outgoing)."
	}

	# -------------------------------------------------------------
	# 6. Sound
	# -------------------------------------------------------------
	menu_sound() {
		show_info "Sound & Audio" "Audio Engine: ALSA / PulseAudio / PipeWire\nMaster Volume: 75%\nOutput Default: Built-in Audio Stereo\nInput: Mikrofon Internal\nSound Effects: Clean Subtle Chimes."
	}

	# -------------------------------------------------------------
	# 7. Bluetooth
	# -------------------------------------------------------------
	menu_bluetooth() {
		show_info "Bluetooth" "Bluetooth Subsystem: BlueZ 5\nStatus: Siap dipasangkan dengan keyboard, mouse, headphone, dan perangkat BLE."
	}

	# -------------------------------------------------------------
	# 8. Printers & Devices
	# -------------------------------------------------------------
	menu_printers() {
		show_info "Printers & Devices" "Spooler: CUPS Printing Daemon\nDriverless IPP / AirPrint: Didukung\nUSB Scanner & Storage: Auto-Mount Aktif."
	}

	# -------------------------------------------------------------
	# 9. Users & Accounts
	# -------------------------------------------------------------
	menu_users() {
		local user_list
		user_list=$(awk -F: '$3 >= 1000 {print $1 " (UID " $3 ")"}' /etc/passwd 2>/dev/null | head -n5)
		show_info "Users & Accounts" "Daftar Pengguna MitraOS:\n${user_list:-mitra (UID 1000)}\n\nAdministrator: root (sudo enabled)\nAutologin: Dikonfigurasi via LightDM / getty."
	}

	# -------------------------------------------------------------
	# 10. Privacy & Security
	# -------------------------------------------------------------
	menu_security() {
		show_info "Privacy & Security" "Audit Keamanan MitraOS:\n- Firewall: UFW / Iptables Aktif\n- Remote SSH: Port 22 (Dropbear/OpenSSH)\n- Kernel Hardening: sysctl memory protect aktif\n- Telemetri Eksternal: NONAKTIF (100% Privacy-First)."
	}

	# -------------------------------------------------------------
	# 11. Software & Updates
	# -------------------------------------------------------------
	menu_software() {
		if [[ -x "$SCRIPT_DIR/mitra-software" ]]; then
			"$SCRIPT_DIR/mitra-software"
		else
			show_info "Software & Updates" "Katalog Software MitraOS:\n- Suite Web Server (Nginx, MariaDB, PHP)\n- Suite Kreatif (GIMP, Inkscape, VLC)\n- Developer Hub (Git, Python, Node, VSCodium)\n- Antigravity AI Engine."
		fi
	}

	# -------------------------------------------------------------
	# 12. Storage
	# -------------------------------------------------------------
	menu_storage() {
		local df_info
		df_info=$(df -h / 2>/dev/null | tail -n1 | awk '{print "Root: " $2 " Total, " $3 " Terpakai, " $4 " Bebas (" $5 ")"}')
		show_info "Storage Manager" "Informasi Penyimpanan MitraOS:\n\n$df_info\n\nManajer Disk: parted, mkfs.ext4, mkfs.fat, e2fsprogs siap digunakan."
	}

	# -------------------------------------------------------------
	# 13. Power
	# -------------------------------------------------------------
	menu_power() {
		show_info "Power Management" "Profil Daya: Balanced (Optimized for Efficiency)\nScreen Timeout: 15 Menit\nSleep / Suspend: Siap\nOptimasi Low-RAM: ZRAM swap ganda aktif."
	}

	# -------------------------------------------------------------
	# 14. Date & Time
	# -------------------------------------------------------------
	menu_datetime() {
		local now_dt
		now_dt=$(date "+%A, %d %B %Y - %T %Z")
		show_info "Date & Time" "Waktu Sistem Saat Ini:\n$now_dt\n\nSinkronisasi NTP: systemd-timesyncd aktif\nZona Waktu Default: Asia/Jakarta (WIB)."
	}

	# -------------------------------------------------------------
	# 15. Language & Region
	# -------------------------------------------------------------
	menu_language() {
		show_info "Language & Region" "Bahasa Sistem: Bahasa Indonesia / English (US)\nFormat Tanggal: DD/MM/YYYY\nFormat Waktu: 24 Jam (HH:MM:SS)\nMata Uang: IDR (Rp) / USD ($)."
	}

	# -------------------------------------------------------------
	# 16. Desktop
	# -------------------------------------------------------------
	menu_desktop() {
		if [[ -x "$SCRIPT_DIR/mitra-desktop" ]]; then
			"$SCRIPT_DIR/mitra-desktop"
		else
			show_info "Desktop Environment" "Profil Desktop MitraOS:\n- macOS Style (Top-bar + Centered Dock + Traffic Lights)\n- Windows 11 Style (Centered Taskbar)\n- Ultra-Low RAM Openbox (<35 MB RAM)."
		fi
	}

	# -------------------------------------------------------------
	# 17. Windows & Window Manager
	# -------------------------------------------------------------
	menu_windows() {
		show_info "Windows & Window Manager" "Window Manager: Openbox / Xfwm4 / KWin\nFokus Jendela: Click to Focus\nSnap Layout: Mitra-Snap aktif (Windows 11 Grid)\nTitlebar Controls: Traffic Light Buttons (Kiri Atas)."
	}

	# -------------------------------------------------------------
	# 18. Startup & Services
	# -------------------------------------------------------------
	menu_startup() {
		show_info "Startup Applications" "Aplikasi Saat Booting:\n- MitraOS Dynamic Banner\n- MitraOS First-Boot Service\n- ZRAM Swap Compressor\n- NetworkManager / WPA Supplicant."
	}

	# -------------------------------------------------------------
	# 19. Accessibility
	# -------------------------------------------------------------
	menu_a11y() {
		show_info "Accessibility" "Aksesibilitas MitraOS:\n- High Contrast Theme\n- Large Text Mode (120% / 150% Scale)\n- Screen Reader (Orca)\n- Sticky Keys & Slow Keys."
	}

	# -------------------------------------------------------------
	# 20. File Manager
	# -------------------------------------------------------------
	menu_filemanager() {
		show_info "File Manager" "Manajer Berkas Default: Thunar / PCManFM\nFitur: Tabbed browsing, icon preview, auto-mount USB drive, dual-pane."
	}

	# -------------------------------------------------------------
	# 21. Notifications
	# -------------------------------------------------------------
	menu_notifications() {
		show_info "Notifications" "Notification Daemon: Dunst / Xfce4-Notifyd\nPosisi: Kanan Atas (Gaya Modern)\nMode Jangan Ganggu (Do Not Disturb): Siap diaktifkan."
	}

	# -------------------------------------------------------------
	# 22. Default Applications
	# -------------------------------------------------------------
	menu_default_apps() {
		show_info "Default Applications" "Aplikasi Bawaan MitraOS:\n- Browser: Chromium / Firefox\n- File Manager: Thunar / PCManFM\n- Email: SnappyMail Web Client\n- Media Player: MPV / VLC\n- Terminal: MitraOS Terminal (XFCE Terminal / Alacritty)."
	}

	# -------------------------------------------------------------
	# 23. System Information
	# -------------------------------------------------------------
	menu_system_info() {
		local kern_ver
		kern_ver=$(uname -r 2>/dev/null || echo "6.1.0-mitraos")
		show_info "About MitraOS" "=== MITRAOS V.1 (APOLLO EDITION) ===\n\nFounder: Qomaruddin Djamal\nOrganisasi: Citra Media Technology & Mitra Utama Group\nArsitektur: $G_HW_ARCH ($G_HW_ARCH_DESC)\nKernel: Linux $kern_ver\nCPU: $G_HW_CPU_MODEL\nRAM Total: ${G_HW_RAM_MB} MB\n\nLisensi: Open-Source Enterprise Community License."
	}

	# -------------------------------------------------------------
	# Main 23-Menu System Preferences Loop
	# -------------------------------------------------------------
	while true; do
		local sel
		sel=$(whiptail --title "MitraOS V.1 - System Preferences" --menu "Pilih kategori preferensi sistem:" 22 76 14 \
			"01" "Appearance (Theme, Dark Mode, Icons, Fonts, Wallpaper)" \
			"02" "Display (Resolution, Scale, Multiple Displays)" \
			"03" "Mouse & Touchpad (Speed, Scrolling, Gestures)" \
			"04" "Keyboard (Layout, Input Method, Shortcuts)" \
			"05" "Network (Wi-Fi, Ethernet, DNS, Firewall)" \
			"06" "Sound (Volume, Output, Input, Effects)" \
			"07" "Bluetooth (Devices, Pair, Settings)" \
			"08" "Printers & Devices (Printers, Scanners, USB)" \
			"09" "Users & Accounts (Users, Passwords, Admin)" \
			"10" "Privacy & Security (Permissions, Firewall, Updates)" \
			"11" "Software & Updates (Repositories, Software Center)" \
			"12" "Storage (Disks, Partitions, Mounts, Usage)" \
			"13" "Power (Battery, Profiles, Sleep, Hibernate)" \
			"14" "Date & Time (Timezone, NTP, Clock)" \
			"15" "Language & Region (Language, Locale, Formats)" \
			"16" "Desktop (macOS / Win11 Styles, Dock, Panel)" \
			"17" "Windows (Snap Layout, Behavior, Traffic Lights)" \
			"18" "Startup (Auto-start Apps, Daemons, Services)" \
			"19" "Accessibility (Large Text, High Contrast, Screen Reader)" \
			"20" "File Manager (Folders, Thumbnails, Hidden Files)" \
			"21" "Notifications (Banners, Do Not Disturb, Position)" \
			"22" "Default Applications (Browser, Mail, Player, Terminal)" \
			"23" "System Info (About MitraOS, Hardware, Kernel, License)" \
			"X"  "Keluar ke Terminal" 3>&1 1>&2 2>&3)
		
		[[ -z "$sel" || "$sel" == "X" ]] && break

		case "$sel" in
			"01") menu_appearance ;;
			"02") menu_display ;;
			"03") menu_mouse ;;
			"04") menu_keyboard ;;
			"05") menu_network ;;
			"06") menu_sound ;;
			"07") menu_bluetooth ;;
			"08") menu_printers ;;
			"09") menu_users ;;
			"10") menu_security ;;
			"11") menu_software ;;
			"12") menu_storage ;;
			"13") menu_power ;;
			"14") menu_datetime ;;
			"15") menu_language ;;
			"16") menu_desktop ;;
			"17") menu_windows ;;
			"18") menu_startup ;;
			"19") menu_a11y ;;
			"20") menu_filemanager ;;
			"21") menu_notifications ;;
			"22") menu_default_apps ;;
			"23") menu_system_info ;;
		esac
	done

	G_EXIT_BANNER
}
