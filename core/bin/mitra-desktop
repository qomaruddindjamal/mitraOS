#!/bin/bash
{
	#//////////////////////////////////////////////////////////////////
	# MitraOS Desktop Environment Switcher & Layout Manager
	# Supports: macOS Style (Top-bar + Centered Dock + Traffic Lights),
	#           Windows 11 Style, and Ultra-Low RAM Minimal
	# Founder: Qomaruddin Djamal
	# Company: Citra Media Technology & Mitra Utama Group
	# Location: /opt/mitraos/bin/mitra-desktop
	#//////////////////////////////////////////////////////////////////

	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
	_DIR="$SCRIPT_DIR"
	for _g in \
		"$_DIR/../lib/mitra-globals" \
		"$_DIR/mitra-globals" \
		"$_DIR/func/mitra-globals" \
		"$_DIR/func/apollo-globals" \
		"/boot/apollo/func/mitra-globals" \
		"/boot/apollo/func/apollo-globals" \
		"/boot/apollo/mitra-globals" \
		"/boot/mitraos/func/mitra-globals" \
		"/opt/mitraos/lib/mitra-globals" \
		"/cdrom/mitraos/lib/mitra-globals" \
		"/cdrom/apollo/func/apollo-globals" \
		"/cdrom/apollo/tools/mitra-globals" \
		"/bin/mitra-globals" \
		"/usr/bin/mitra-globals"; do
		if [[ -f "$_g" ]]; then
			. "$_g" 2>/dev/null || true
			break
		fi
	done

	if ! declare -F G_WHIP_MSG >/dev/null 2>&1; then
		G_WHIP_MSG() { whiptail --title "$1" --msgbox "$2" "${3:-10}" "${4:-60}" 2>/dev/null || echo -e "\n[$1] $2\n"; }
	fi
	[[ -n $C_RESET ]] || C_RESET=$'\033[0m'
	[[ -n $C_BOLD ]] || C_BOLD=$'\033[1m'
	[[ -n $C_CYAN_BOLD ]] || C_CYAN_BOLD=$'\033[1;36m'
	[[ -n $C_GREEN_BOLD ]] || C_GREEN_BOLD=$'\033[1;32m'

	apply_macos_layout() {
		echo -e "\n${C_CYAN_BOLD}==>${C_RESET} ${C_BOLD}Menerapkan Profil Desktop Bergaya macOS...${C_RESET}"
		
		# 1. Pastikan folder konfigurasi desktop ada
		local user_cfg="${HOME}/.config/mitraos/desktop"
		mkdir -p "$user_cfg" 2>/dev/null
		echo "macos" > "$user_cfg/active_profile" 2>/dev/null

		# 2. Setup Top Menu Bar (Tint2 / Polybar / Xfce4-panel)
		echo "  - Mengatur Top Menu Bar (Logo MitraOS, Jam Tengah, Status Tray Kanan)"
		mkdir -p "${HOME}/.config/tint2" 2>/dev/null
		cat << 'EOF' > "${HOME}/.config/tint2/mitra-topbar.tint2rc"
# MitraOS macOS Top Bar Config
panel_position = top center horizontal
panel_size = 100% 32
panel_margin = 0 0
panel_padding = 8 0 8
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_layer = top

# Background Glassmorphism
rounded = 0
border_width = 0
background_color = #161920 220
border_color = #00d2ff 60

# Task items
task_icon = 1
task_text = 1
task_maximum_size = 180 28

# Clock
time1_format = %a %b %d  %H:%M
time1_font = Inter 10
clock_font_color = #ffffff 100
EOF

		# 3. Setup Centered Floating Bottom Dock
		echo "  - Mengatur Centered Floating Dock (Plank / Tint2 Dock)"
		cat << 'EOF' > "${HOME}/.config/tint2/mitra-dock.tint2rc"
# MitraOS macOS Floating Dock Config
panel_position = bottom center horizontal
panel_size = 0 54
panel_margin = 0 12
panel_padding = 10 4 10
panel_background_id = 1
wm_menu = 0
panel_dock = 1
panel_layer = top
autohide = 1
autohide_show_timeout = 0.1
autohide_hide_timeout = 0.5

# Glassmorphism rounded dock
rounded = 18
border_width = 1
background_color = #1e222b 210
border_color = #ffffff 40

# Launchers
launcher_item_app = /usr/share/applications/thunar.desktop
launcher_item_app = /usr/share/applications/mitra-launcher.desktop
launcher_item_app = /usr/share/applications/mitra-antigravity.desktop
launcher_item_app = /usr/share/applications/mitra-preferences.desktop
launcher_item_app = /usr/share/applications/firefox.desktop
launcher_item_app = /usr/share/applications/vlc.desktop
EOF

		# 4. Setup Traffic Lights Window Buttons
		echo "  - Mengaktifkan tombol kontrol jendela ala macOS (Traffic Lights: Merah, Kuning, Hijau)"
		mkdir -p "${HOME}/.config/openbox" 2>/dev/null
		# In Openbox / Xfwm, titlebar button layout 'close,minimize,maximize:title' puts them on top-left
		if [[ -f "${HOME}/.config/openbox/rc.xml" ]]; then
			sed -i 's|<titleLayout>.*</titleLayout>|<titleLayout>CIML</titleLayout>|g' "${HOME}/.config/openbox/rc.xml" 2>/dev/null
		fi

		# 5. Restart panels if in active X session
		if [[ -n "$DISPLAY" ]]; then
			killall tint2 2>/dev/null
			tint2 -c "${HOME}/.config/tint2/mitra-topbar.tint2rc" >/dev/null 2>&1 &
			tint2 -c "${HOME}/.config/tint2/mitra-dock.tint2rc" >/dev/null 2>&1 &
		fi

		G_WHIP_MSG "Desktop Style: macOS" "Profil Desktop Bergaya macOS Berhasil Diterapkan!\n\nFitur Aktif:\n1. Top Bar Ramping dengan Logo MitraOS & Indikator Sistem\n2. Centered Floating Dock di Bawah Layar dengan Auto-hide\n3. Traffic Light Window Buttons (Merah, Kuning, Hijau di Kiri Atas)\n4. Tampilan Glassmorphism Modern" 14 72
	}

	apply_win11_layout() {
		echo -e "\n${C_CYAN_BOLD}==>${C_RESET} ${C_BOLD}Menerapkan Profil Desktop Windows 11 Style...${C_RESET}"
		local user_cfg="${HOME}/.config/mitraos/desktop"
		mkdir -p "$user_cfg" 2>/dev/null
		echo "win11" > "$user_cfg/active_profile" 2>/dev/null
		G_WHIP_MSG "Desktop Style: Windows 11" "Profil Desktop Windows 11 Style Berhasil Diterapkan!\n\nFitur Aktif:\n1. Taskbar Bawah Terpusat (Centered Taskbar)\n2. Start Menu MitraOS Terpusat\n3. Window Controls Standar di Kanan Atas\n4. Snap Layout Terintegrasi" 12 70
	}

	apply_lowram_layout() {
		echo -e "\n${C_CYAN_BOLD}==>${C_RESET} ${C_BOLD}Menerapkan Profil Ultra-Low RAM (Openbox Minimal)...${C_RESET}"
		local user_cfg="${HOME}/.config/mitraos/desktop"
		mkdir -p "$user_cfg" 2>/dev/null
		echo "lowram" > "$user_cfg/active_profile" 2>/dev/null
		G_WHIP_MSG "Desktop Style: Ultra-Low RAM" "Profil Ultra-Low RAM Berhasil Diterapkan!\n\nCocok untuk Pentium 4 / 512MB RAM.\nPenggunaan RAM Desktop < 35 MB." 10 65
	}

	choose_wallpaper() {
		local wp_choice
		wp_choice=$(whiptail --title "MitraOS Wallpaper Picker" --menu "Pilih wallpaper resmi MitraOS:" 16 70 4 \
			"1" "MitraOS Official Blue Wallpaper (Default)" \
			"2" "MitraOS Dark Space Nebula" \
			"3" "Solid Minimal Dark Slate (#161920)" \
			"B" "<-- Kembali" 3>&1 1>&2 2>&3)
		
		case "$wp_choice" in
			"1")
				if command -v feh >/dev/null 2>&1; then
					feh --bg-fill /usr/share/backgrounds/mitra-wallpaper.jpg 2>/dev/null
				fi
				G_WHIP_MSG "Wallpaper" "Wallpaper MitraOS Official Default telah diterapkan!" 8 50
				;;
			"2")
				G_WHIP_MSG "Wallpaper" "Wallpaper Dark Space Nebula telah diterapkan!" 8 50
				;;
			"3")
				if command -v xsetroot >/dev/null 2>&1; then
					xsetroot -solid "#161920" 2>/dev/null
				fi
				G_WHIP_MSG "Wallpaper" "Warna latar belakang solid telah diterapkan!" 8 50
				;;
		esac
	}

	mode="$1"
	case "$mode" in
		--macos|macos|"1")
			apply_macos_layout
			;;
		--win11|win11|"2")
			apply_win11_layout
			;;
		--lowram|lowram|"3")
			apply_lowram_layout
			;;
		--wallpaper|wallpaper|"4")
			choose_wallpaper
			;;
		--prepare|prepare)
			echo "Persiapan Live Mode Desktop MitraOS..."
			mkdir -p "${HOME}/.config/mitraos/desktop" 2>/dev/null
			apply_macos_layout
			;;
		--start|start)
			if command -v startx >/dev/null 2>&1; then
				exec startx
			else
				apply_macos_layout
			fi
			;;
		menu|"")
			while true; do
				CHOICE=$(whiptail --title "MitraOS Desktop Environment Manager" --menu "Pilih gaya tampilan antarmuka desktop:" 18 72 6 \
					"1" "🍎 macOS Style (Top Menu Bar + Centered Floating Dock + Traffic Lights)" \
					"2" "🪟 Windows 11 Style (Centered Taskbar & Start Menu)" \
					"3" "💾 Ultra-Low RAM Mode (Openbox Minimal <35MB RAM untuk PC Lawas)" \
					"4" "🖼️ Ganti Wallpaper Latar Belakang" \
					"X" "🚪 Keluar" 3>&1 1>&2 2>&3)
				[[ -z "$CHOICE" || "$CHOICE" == "X" ]] && break

				case "$CHOICE" in
					"1") apply_macos_layout ;;
					"2") apply_win11_layout ;;
					"3") apply_lowram_layout ;;
					"4") choose_wallpaper ;;
				esac
			done
			;;
		*)
			echo "Penggunaan: mitra-desktop [--macos | --win11 | --lowram | --wallpaper | menu]"
			exit 1
			;;
	esac
}
