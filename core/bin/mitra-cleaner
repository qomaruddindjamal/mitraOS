#!/bin/bash
{
	#//////////////////////////////////////////////////////////////////
	# Apollo OS - Storage & Cache Cleaner
	#//////////////////////////////////////////////////////////////////

	_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
	# Load Globals with broad discovery
	for _g in \
		"$_DIR/../lib/mitra-globals" \
		"$_DIR/mitra-globals" \
		"$_DIR/func/mitra-globals" \
		"$_DIR/func/apollo-globals" \
		"/boot/apollo/func/mitra-globals" \
		"/boot/apollo/func/apollo-globals" \
		"/boot/apollo/mitra-globals" \
		"/boot/mitraos/func/mitra-globals" \
		"/opt/mitraos/lib/mitra-globals" \
		"/cdrom/mitraos/lib/mitra-globals" \
		"/cdrom/apollo/func/apollo-globals" \
		"/cdrom/apollo/tools/mitra-globals" \
		"/bin/mitra-globals" \
		"/usr/bin/mitra-globals"; do
		if [[ -f "$_g" ]]; then
			. "$_g" 2>/dev/null || true
			break
		fi
	done

	if ! declare -F G_CHECK_ROOT_USER >/dev/null 2>&1; then
		G_CHECK_ROOT_USER() { :; }
	fi
	if ! declare -F G_WHIP_MSG >/dev/null 2>&1; then
		G_WHIP_MSG() { whiptail --title "$1" --msgbox "$2" "${3:-10}" "${4:-60}" 2>/dev/null || echo -e "
[$1] $2
"; }
	fi

	G_PROGRAM_NAME='Apollo OS - Cleaner'
	G_CHECK_ROOT_USER "$@"

	if G_WHIP_YESNO "Apollo OS Cleaner" "This utility will:\n- Clean APT package cache (/var/cache/apt/archives)\n- Remove orphaned packages and dependencies\n- Vacuum systemd journal logs to 50MB\n- Purge temporary files in /tmp and /var/tmp\n\nProceed?"; then
		G_APOLLO-NOTIFY -1 "Cleaning APT archives..."
		apt-get -y clean
		apt-get -y autoclean
		G_APOLLO-NOTIFY -1 "Removing orphan packages..."
		apt-get -y autoremove --purge
		G_APOLLO-NOTIFY -1 "Vacuuming systemd journal logs to 50M..."
		journalctl --vacuum-size=50M 2>/dev/null
		G_APOLLO-NOTIFY -1 "Cleaning temporary files..."
		rm -rf /tmp/* /var/tmp/* 2>/dev/null
		G_APOLLO-NOTIFY 1 "System optimization and cleanup complete!"
		G_WHIP_MSG "Completed" "Apollo OS system cleaning completed successfully."
	fi

	G_EXIT_BANNER
}
